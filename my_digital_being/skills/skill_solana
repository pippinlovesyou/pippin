            return StakeResult(success=False, error=str(e))

    async def get_stake_accounts(
        self,
        address: Optional[str] = None
    ) -> list[StakeAccountInfo]:
        """List all stake accounts owned by a wallet."""
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        if address is None:
            owner_pubkey = self.keypair.pubkey()
        else:
            owner_pubkey = Pubkey.from_string(address)

        try:
            stake_program = Pubkey.from_string(STAKE_PROGRAM_ID)

            response = await self.client.get_program_accounts(
                stake_program,
                commitment=Confirmed,
                encoding="jsonParsed",
                filters=[
                    {"memcmp": {"offset": 12, "bytes": str(owner_pubkey)}}
                ]
            )

            stake_accounts = []
            for account in response.value:
                try:
                    parsed = account.account.data.parsed
                    info = parsed["info"]
                    stake_info = info.get("stake", {})
                    delegation = stake_info.get("delegation", {})

                    state = parsed.get("type", "unknown")

                    stake_accounts.append(StakeAccountInfo(
                        address=str(account.pubkey),
                        lamports=account.account.lamports,
                        state=state,
                        voter=delegation.get("voter"),
                        activation_epoch=delegation.get("activationEpoch"),
                        deactivation_epoch=delegation.get("deactivationEpoch")
                    ))
                except (KeyError, TypeError, AttributeError) as e:
                    logger.debug(f"Skipping malformed stake account: {e}")
                    continue

            return stake_accounts

        except Exception as e:
            logger.error(f"Failed to fetch stake accounts: {e}")
            return []


