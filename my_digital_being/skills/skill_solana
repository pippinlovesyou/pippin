    async def get_nfts(
        self,
        address: Optional[str] = None
    ) -> list[NFTMetadata]:
        """
        Fetch all NFTs owned by a wallet.

        Uses Helius DAS API if HELIUS_API_KEY is set, otherwise falls back
        to on-chain parsing of token accounts with decimals=0 and amount=1.
        """
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        if address is None:
            owner = str(self.keypair.pubkey())
        else:
            owner = address

        if self._helius_api_key:
            return await self._get_nfts_helius(owner)
        else:
            return await self._get_nfts_onchain(owner)

    async def _get_nfts_helius(self, owner: str) -> list[NFTMetadata]:
        """Fetch NFTs using Helius DAS API."""
        try:
            rpc_url = f"https://mainnet.helius-rpc.com/?api-key={self._helius_api_key}"

            payload = {
                "jsonrpc": "2.0",
                "id": "helius-nft-fetch",
                "method": "getAssetsByOwner",
                "params": {
                    "ownerAddress": owner,
                    "page": 1,
                    "limit": 1000,
                    "displayOptions": {
                        "showFungible": False,
                        "showNativeBalance": False
                    }
                }
            }

            resp = await self.http_client.post(rpc_url, json=payload)

            if resp.status_code != 200:
                logger.error(f"Helius DAS API error: {resp.text}")
                return await self._get_nfts_onchain(owner)

            data = resp.json()
            result = data.get("result", {})
            items = result.get("items", [])

            nfts = []
            for item in items:
                try:
                    content = item.get("content", {})
                    metadata = content.get("metadata", {})
                    links = content.get("links", {})

                    grouping = item.get("grouping", [])
                    collection = None
                    for group in grouping:
                        if group.get("group_key") == "collection":
                            collection = group.get("group_value")
                            break

                    nfts.append(NFTMetadata(
                        mint=item.get("id", ""),
                        name=metadata.get("name", "Unknown"),
                        symbol=metadata.get("symbol", ""),
                        uri=content.get("json_uri", ""),
                        image=links.get("image"),
                        description=metadata.get("description"),
                        collection=collection,
                        attributes=metadata.get("attributes", [])
                    ))
                except (KeyError, TypeError) as e:
                    logger.debug(f"Skipping malformed NFT: {e}")
                    continue

            return nfts

        except Exception as e:
            logger.error(f"Helius NFT fetch failed: {e}")
            return await self._get_nfts_onchain(owner)


    async def _get_nfts_onchain(self, owner: str) -> list[NFTMetadata]:
        """Fetch NFTs by parsing token accounts with decimals=0 and amount=1."""
        try:
            owner_pubkey = Pubkey.from_string(owner)

            response = await self.client.get_token_accounts_by_owner_json_parsed(
                owner_pubkey,
                opts={"programId": Pubkey.from_string(TOKEN_PROGRAM_ID)},
                commitment=Confirmed
            )

            nfts = []
            for account in response.value:
                try:
                    info = account.account.data.parsed["info"]
                    token_amount = info["tokenAmount"]

                    if (token_amount["decimals"] == 0 and
                        int(token_amount["amount"]) == 1):

                        mint = info["mint"]

                        metadata = await self._fetch_nft_metadata(mint)
                        if metadata:
                            nfts.append(metadata)
                        else:
                            nfts.append(NFTMetadata(
                                mint=mint,
                                name="Unknown NFT",
                                symbol="",
                                uri=""
                            ))

                except (KeyError, TypeError) as e:
                    logger.debug(f"Skipping token account: {e}")
                    continue

            return nfts

        except Exception as e:
            logger.error(f"On-chain NFT fetch failed: {e}")
            return []

    async def _fetch_nft_metadata(self, mint: str) -> Optional[NFTMetadata]:
        """Fetch metadata for a single NFT from the metadata program."""
        try:
            mint_pubkey = Pubkey.from_string(mint)
            metadata_program = Pubkey.from_string(TOKEN_METADATA_PROGRAM_ID)

            seeds = [
                b"metadata",
                bytes(metadata_program),
                bytes(mint_pubkey),
            ]
            metadata_pda, _ = Pubkey.find_program_address(seeds, metadata_program)

            account_resp = await self.client.get_account_info(
                metadata_pda,
                commitment=Confirmed
            )

            if not account_resp.value:
                return None

            data = bytes(account_resp.value.data)

            if len(data) < 100:
                return None

            offset = 1 + 32 + 32

            name_len = struct.unpack("<I", data[offset:offset+4])[0]
            offset += 4
            name = data[offset:offset+name_len].decode("utf-8").rstrip("\x00")
            offset += name_len

            symbol_len = struct.unpack("<I", data[offset:offset+4])[0]
            offset += 4
            symbol = data[offset:offset+symbol_len].decode("utf-8").rstrip("\x00")
            offset += symbol_len

            uri_len = struct.unpack("<I", data[offset:offset+4])[0]
            offset += 4
            uri = data[offset:offset+uri_len].decode("utf-8").rstrip("\x00")

            image = None
            description = None
            attributes = []

            if uri:
                try:
                    json_resp = await self.http_client.get(uri, timeout=5.0)
                    if json_resp.status_code == 200:
                        json_data = json_resp.json()
                        image = json_data.get("image")
                        description = json_data.get("description")
                        attributes = json_data.get("attributes", [])
                except Exception:
                    pass

            return NFTMetadata(
                mint=mint,
                name=name,
                symbol=symbol,
                uri=uri,
                image=image,
                description=description,
                attributes=attributes
            )

        except Exception as e:
            logger.debug(f"Failed to fetch NFT metadata for {mint}: {e}")
            return None


    async def transfer_nft(
        self,
        mint: str,
        recipient: str
    ) -> NFTTransferResult:
        """
        Transfer an NFT to another wallet.

        This is a wrapper around transfer_spl_token with amount=1.
        """
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        try:
            result = await self.transfer_spl_token(
                mint=mint,
                recipient=recipient,
                amount=1
            )

            if result.success:
                logger.info(f"NFT transfer executed: {result.signature}")
                return NFTTransferResult(
                    success=True,
                    signature=result.signature,
                    mint=mint,
                    recipient=recipient
                )
            else:
                return NFTTransferResult(
                    success=False,
                    error=result.error,
                    mint=mint,
                    recipient=recipient
                )

        except Exception as e:
            logger.error(f"NFT transfer failed: {e}")
            return NFTTransferResult(
                success=False,
                error=str(e),
                mint=mint,
                recipient=recipient
            )

    async def get_nft_floor_price(
        self,
        collection_symbol: str
    ) -> Optional[float]:
        """Get floor price for an NFT collection from Magic Eden API."""
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        try:
            url = f"{MAGIC_EDEN_API}/collections/{collection_symbol}/stats"

            resp = await self.http_client.get(url)

            if resp.status_code != 200:
                logger.error(f"Magic Eden API error: {resp.text}")
                return None

            data = resp.json()
            floor_price = data.get("floorPrice")

            if floor_price is not None:
                return floor_price / LAMPORTS_PER_SOL

            return None

        except Exception as e:
            logger.error(f"Floor price lookup failed: {e}")
            return None


