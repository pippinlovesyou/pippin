    async def transfer_sol(
        self,
        recipient: str,
        amount: float
    ) -> TransferResult:
        """Transfer SOL to another wallet."""
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        try:
            recipient_pubkey = Pubkey.from_string(recipient)
            lamports = int(amount * LAMPORTS_PER_SOL)

            blockhash_resp = await self.client.get_latest_blockhash(
                commitment=Confirmed
            )
            recent_blockhash = blockhash_resp.value.blockhash

            transfer_ix = transfer(
                TransferParams(
                    from_pubkey=self.keypair.pubkey(),
                    to_pubkey=recipient_pubkey,
                    lamports=lamports
                )
            )

            msg = message.Message.new_with_blockhash(
                [transfer_ix],
                self.keypair.pubkey(),
                Hash.from_string(str(recent_blockhash))
            )
            tx = Transaction.new_unsigned(msg)
            tx.sign([self.keypair], Hash.from_string(str(recent_blockhash)))

            opts = TxOpts(skip_preflight=False, preflight_commitment=Processed)
            result = await self.client.send_raw_transaction(
                bytes(tx),
                opts=opts
            )

            tx_sig = json.loads(result.to_json())["result"]

            logger.info(f"SOL transfer executed: {tx_sig}")

            return TransferResult(
                success=True,
                signature=tx_sig,
                amount=amount,
                recipient=recipient
            )

        except Exception as e:
            logger.error(f"SOL transfer failed: {e}")
            return TransferResult(success=False, error=str(e))

    def _get_associated_token_address(
        self,
        owner: Pubkey,
        mint: Pubkey
    ) -> Pubkey:
        """Derive the associated token account address for an owner and mint."""
        seeds = [
            bytes(owner),
            bytes(Pubkey.from_string(TOKEN_PROGRAM_ID)),
            bytes(mint),
        ]
        program_id = Pubkey.from_string(ASSOCIATED_TOKEN_PROGRAM_ID)

        ata, _ = Pubkey.find_program_address(seeds, program_id)
        return ata

    def _create_ata_instruction(
        self,
        payer: Pubkey,
        owner: Pubkey,
        mint: Pubkey
    ) -> Instruction:
        """Create instruction to initialize an associated token account."""
        ata = self._get_associated_token_address(owner, mint)

        keys = [
            AccountMeta(payer, is_signer=True, is_writable=True),
            AccountMeta(ata, is_signer=False, is_writable=True),
            AccountMeta(owner, is_signer=False, is_writable=False),
            AccountMeta(mint, is_signer=False, is_writable=False),
            AccountMeta(
                Pubkey.from_string(SYSTEM_PROGRAM_ID),
                is_signer=False,
                is_writable=False
            ),
            AccountMeta(
                Pubkey.from_string(TOKEN_PROGRAM_ID),
                is_signer=False,
                is_writable=False
            ),
        ]

        return Instruction(
            program_id=Pubkey.from_string(ASSOCIATED_TOKEN_PROGRAM_ID),
            accounts=keys,
            data=bytes()
        )

    def _create_token_transfer_instruction(
        self,
        source: Pubkey,
        destination: Pubkey,
        owner: Pubkey,
        amount: int
    ) -> Instruction:
        """Create SPL token transfer instruction."""
        keys = [
            AccountMeta(source, is_signer=False, is_writable=True),
            AccountMeta(destination, is_signer=False, is_writable=True),
            AccountMeta(owner, is_signer=True, is_writable=False),
        ]

        data = bytes([3]) + struct.pack("<Q", amount)

        return Instruction(
            program_id=Pubkey.from_string(TOKEN_PROGRAM_ID),
            accounts=keys,
            data=data
        )

    async def transfer_spl_token(
        self,
        mint: str,
        recipient: str,
        amount: float
    ) -> TransferResult:
        """Transfer SPL tokens to another wallet. Auto-creates recipient ATA if needed."""
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        try:
            mint_pubkey = Pubkey.from_string(mint)
            recipient_pubkey = Pubkey.from_string(recipient)

            mint_resp = await self.client.get_account_info_json_parsed(
                mint_pubkey,
                commitment=Confirmed
            )
            if not mint_resp.value:
                return TransferResult(success=False, error="Invalid mint address")

            decimals = mint_resp.value.data.parsed["info"]["decimals"]
            raw_amount = int(amount * (10 ** decimals))

            source_ata = self._get_associated_token_address(
                self.keypair.pubkey(),
                mint_pubkey
            )
            dest_ata = self._get_associated_token_address(
                recipient_pubkey,
                mint_pubkey
            )

            instructions = []

            dest_ata_resp = await self.client.get_account_info(
                dest_ata,
                commitment=Confirmed
            )
            if not dest_ata_resp.value:
                create_ata_ix = self._create_ata_instruction(
                    self.keypair.pubkey(),
                    recipient_pubkey,
                    mint_pubkey
                )
                instructions.append(create_ata_ix)
                logger.info(f"Creating ATA for recipient: {dest_ata}")

            transfer_ix = self._create_token_transfer_instruction(
                source_ata,
                dest_ata,
                self.keypair.pubkey(),
                raw_amount
            )
            instructions.append(transfer_ix)

            blockhash_resp = await self.client.get_latest_blockhash(
                commitment=Confirmed
            )
            recent_blockhash = blockhash_resp.value.blockhash

            msg = message.Message.new_with_blockhash(
                instructions,
                self.keypair.pubkey(),
                Hash.from_string(str(recent_blockhash))
            )
            tx = Transaction.new_unsigned(msg)
            tx.sign([self.keypair], Hash.from_string(str(recent_blockhash)))

            opts = TxOpts(skip_preflight=False, preflight_commitment=Processed)
            result = await self.client.send_raw_transaction(
                bytes(tx),
                opts=opts
            )

            tx_sig = json.loads(result.to_json())["result"]

            logger.info(f"SPL token transfer executed: {tx_sig}")

            return TransferResult(
                success=True,
                signature=tx_sig,
                amount=amount,
                recipient=recipient
            )

        except Exception as e:
            logger.error(f"SPL token transfer failed: {e}")
            return TransferResult(success=False, error=str(e))

