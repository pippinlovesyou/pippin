    async def stake_sol_native(
        self,
        amount: float,
        validator_vote_account: str
    ) -> StakeResult:
        """Stake SOL natively to a validator."""
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        try:
            lamports = int(amount * LAMPORTS_PER_SOL)
            voter_pubkey = Pubkey.from_string(validator_vote_account)
            stake_program = Pubkey.from_string(STAKE_PROGRAM_ID)

            stake_keypair = Keypair()
            stake_pubkey = stake_keypair.pubkey()

            rent_resp = await self.client.get_minimum_balance_for_rent_exemption(200)
            rent_lamports = rent_resp.value

            total_lamports = lamports + rent_lamports

            create_account_ix = Instruction(
                program_id=Pubkey.from_string(SYSTEM_PROGRAM_ID),
                accounts=[
                    AccountMeta(self.keypair.pubkey(), is_signer=True, is_writable=True),
                    AccountMeta(stake_pubkey, is_signer=True, is_writable=True),
                ],
                data=bytes([0, 0, 0, 0]) + struct.pack("<Q", total_lamports) +
                     struct.pack("<Q", 200) + bytes(stake_program)
            )

            staker_bytes = bytes(self.keypair.pubkey())
            withdrawer_bytes = bytes(self.keypair.pubkey())

            authorized_data = staker_bytes + withdrawer_bytes
            lockup_data = bytes(8 + 8 + 32)
            initialize_data = bytes([0, 0, 0, 0]) + authorized_data + lockup_data

            initialize_ix = Instruction(
                program_id=stake_program,
                accounts=[
                    AccountMeta(stake_pubkey, is_signer=False, is_writable=True),
                    AccountMeta(
                        Pubkey.from_string(SYSVAR_RENT_ID),
                        is_signer=False,
                        is_writable=False
                    ),
                ],
                data=initialize_data
            )

            delegate_data = bytes([2, 0, 0, 0])

            delegate_ix = Instruction(
                program_id=stake_program,
                accounts=[
                    AccountMeta(stake_pubkey, is_signer=False, is_writable=True),
                    AccountMeta(voter_pubkey, is_signer=False, is_writable=False),
                    AccountMeta(
                        Pubkey.from_string(SYSVAR_CLOCK_ID),
                        is_signer=False,
                        is_writable=False
                    ),
                    AccountMeta(
                        Pubkey.from_string(SYSVAR_STAKE_HISTORY_ID),
                        is_signer=False,
                        is_writable=False
                    ),
                    AccountMeta(
                        Pubkey.from_string(STAKE_CONFIG_ID),
                        is_signer=False,
                        is_writable=False
                    ),
                    AccountMeta(self.keypair.pubkey(), is_signer=True, is_writable=False),
                ],
                data=delegate_data
            )

            blockhash_resp = await self.client.get_latest_blockhash(
                commitment=Confirmed
            )
            recent_blockhash = blockhash_resp.value.blockhash

            instructions = [create_account_ix, initialize_ix, delegate_ix]

            msg = message.Message.new_with_blockhash(
                instructions,
                self.keypair.pubkey(),
                Hash.from_string(str(recent_blockhash))
            )
            tx = Transaction.new_unsigned(msg)
            tx.sign(
                [self.keypair, stake_keypair],
                Hash.from_string(str(recent_blockhash))
            )

            opts = TxOpts(skip_preflight=False, preflight_commitment=Processed)
            result = await self.client.send_raw_transaction(
                bytes(tx),
                opts=opts
            )

            tx_sig = json.loads(result.to_json())["result"]

            logger.info(
                f"Native stake created: {tx_sig}, stake account: {stake_pubkey}"
            )

            return StakeResult(
                success=True,
                signature=tx_sig,
                stake_account=str(stake_pubkey),
                amount_lamports=lamports
            )

        except Exception as e:
            logger.error(f"Native staking failed: {e}")
            return StakeResult(success=False, error=str(e))


    async def stake_sol_marinade(
        self,
        amount: float,
        slippage_bps: int = 50
    ) -> StakeResult:
        """Liquid stake SOL via Marinade by swapping SOL to mSOL through Jupiter."""
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        try:
            lamports = int(amount * LAMPORTS_PER_SOL)

            swap_result = await self.execute_swap(
                input_mint=SOL_MINT,
                output_mint=MSOL_MINT,
                amount=lamports,
                slippage_bps=slippage_bps
            )

            if not swap_result.success:
                return StakeResult(
                    success=False,
                    error=f"Marinade stake swap failed: {swap_result.error}"
                )

            logger.info(
                f"Marinade stake completed: {swap_result.signature}, "
                f"mSOL received: {swap_result.out_amount}"
            )

            return StakeResult(
                success=True,
                signature=swap_result.signature,
                amount_lamports=lamports
            )

        except Exception as e:
            logger.error(f"Marinade staking failed: {e}")
            return StakeResult(success=False, error=str(e))

    async def unstake_marinade(
        self,
        amount: float,
        slippage_bps: int = 50
    ) -> StakeResult:
        """Instant unstake mSOL back to SOL via Jupiter swap."""
        if not self._initialized:
            raise RuntimeError("Skill not initialized")

        try:
            msol_amount = int(amount * 1_000_000_000)

            swap_result = await self.execute_swap(
                input_mint=MSOL_MINT,
                output_mint=SOL_MINT,
                amount=msol_amount,
                slippage_bps=slippage_bps
            )

            if not swap_result.success:
                return StakeResult(
                    success=False,
                    error=f"Marinade unstake swap failed: {swap_result.error}"
                )

            logger.info(
                f"Marinade unstake completed: {swap_result.signature}, "
                f"SOL received: {swap_result.out_amount}"
            )

            return StakeResult(
                success=True,
                signature=swap_result.signature,
                amount_lamports=swap_result.out_amount
